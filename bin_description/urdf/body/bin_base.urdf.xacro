<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
<xacro:property name="base_width" value="0.227" />
<xacro:property name="base_length" value="0.224725" />
<xacro:property name="base_height" value="0.140234" />
<xacro:property name="com_x" value="0.00489" />     <!--Center of Mass-->
<xacro:property name="com_y" value="-0.00007433" /> 
<xacro:property name="com_z" value="0.001" /> 
<xacro:property name="base_mass" value="1.5" />



<xacro:macro name="bin_base" params="prefix z_off">
    <link name="base_footprint"/>
    <link name="${prefix}base_link">
        <visual>
            <geometry>
                <mesh filename="package://bin_description/meshes/Base.stl" scale="1 1 1"/>
            </geometry>
            <origin xyz="0 0 ${base_height - wheel_radius}" rpy="0 0 0"/>
            <material name="white">
                <color rgba="1 1 1 0.5"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <mesh filename="package://bin_description/meshes/Base.stl" scale="1 1 1"/>
            </geometry>
            <origin xyz="0 0 ${base_height - wheel_radius}" rpy="0 0 0"/>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="${base_mass}"/>
            <inertia ixx="${(1/12) * base_mass * ((base_width * base_width) + (base_height * base_height))}"  ixy="0.0"  ixz="0.0"  
                     iyy="${(1/12) * base_mass * ((base_length * base_length) + (base_height * base_height))}"  iyz="0.0" 
                     izz="${(1/12) * base_mass * ((base_length * base_length) + (base_width * base_width))}"/>
        </inertial>
    </link>
    <joint name="${prefix}base_joint" type="fixed">
        <parent link="${prefix}base_footprint"/>
        <child link="${prefix}base_link"/>
        <origin xyz="0 0 ${z_off}" rpy="0 0 0"/>
  </joint>


  <link name="${prefix}bin_castor_link">
    <visual>
        <origin xyz="0.08 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <!-- <origin xyz="0.0 0.0 0.011" rpy="0.0 0.0 0.0"/> -->
        <geometry>
            <mesh filename="package://bin_description/meshes/Caster Wheel.stl" scale="1 1 1"/>
        </geometry>
        <material name="black">
            <color rgba="0 0 0 0.5"/>
        </material>
    </visual>
    <collision>
        <origin xyz="0.08 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <geometry>
            <mesh filename="package://bin_description/meshes/Caster Wheel.stl" scale="1 1 1"/>
        </geometry>
    </collision>
    <inertial>
        <mass value="0.01"/>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <inertia ixx="0.0"  ixy="0.0"  ixz="0.0"
                    iyy="3.288427e-6"  iyz="0.0"
                    izz="3.29244e-6"/>
    </inertial>
  </link>

  <joint name="${prefix}base_castor_joint" type="fixed">
    <origin xyz="-0.08 0.0 0.0" rpy="0.0 0.0 0.0"/>
    <parent link="${prefix}base_link"/>
    <child link="${prefix}bin_castor_link"/>
  </joint>
</xacro:macro>
</robot>