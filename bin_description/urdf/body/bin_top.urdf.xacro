<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:property name="bin_mass" value="0.1" />
    <xacro:property name="bin_length" value="0.270" />
    <xacro:property name="bin_width" value="0.270" />
    <xacro:property name="bin_height" value="0.3048" />


    

    <xacro:macro name="bin_top" params="prefix height">

        <link name="${prefix}bin_top_link">
            <visual>
                <geometry>
                    <mesh filename="package://bin_description/meshes/Bin.stl" scale="1 1 1"/>
                </geometry>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <material name="white">
                    <color rgba="1 1 1 1"/>
                </material>
            </visual>
            <collision>
                <geometry>
                    <box size="0.036 0.036 0.0768"/>
                </geometry>
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </collision>
            <inertial>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <mass value="${bin_mass}"/>
                <inertia ixx="${(1/12) * bin_mass * ((bin_width * bin_width) + (bin_height * bin_height))}"  ixy="0.0"  ixz="0.0"  
                        iyy="${(1/12) * bin_mass * ((bin_length * bin_length) + (bin_height * bin_height))}"  iyz="0.0" 
                        izz="${(1/12) * bin_mass * ((bin_length * bin_length) + (bin_width * bin_width))}"/>
            </inertial>

        </link>
        <joint name="${prefix}base_top_joint" type="fixed">
            <parent link="${prefix}base_link"/>
            <child link="${prefix}bin_top_link"/>
            <origin xyz="0 0 ${height}" rpy="0 0 0"/>
        </joint>
    </xacro:macro>
</robot>